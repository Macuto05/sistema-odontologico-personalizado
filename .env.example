# Supabase Postgres (servidor, fuente de verdad — ver constitution.md Technology & Architecture
# Constraints). DATABASE_URL = pooler Supavisor en modo transacción (runtime de la app).
# DIRECT_URL = conexión directa sin pooler, solo para `prisma migrate`/`db push`.
DATABASE_URL="postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage/API (Settings → API en el dashboard de Supabase)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="reemplazar-con-la-anon-key"
SUPABASE_SERVICE_ROLE_KEY="reemplazar-con-la-service-role-key-solo-server-side"

# Auth.js (NextAuth) — cuenta única del odontólogo
AUTH_SECRET="reemplazar-con-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# Cuenta única sembrada por prisma/seed.ts (T018) — cambiar antes de usar en producción
SEED_ODONTOLOGO_NOMBRE="Nombre Apellido"
SEED_ODONTOLOGO_EMAIL="odontologo@example.com"
SEED_ODONTOLOGO_PASSWORD="cambiar-esta-contrasena"

# Cuenta separada, exclusiva para los tests e2e (prisma/seed.ts la siembra si están
# presentes). Nunca debe coincidir con la cuenta real de arriba — los tests cambian
# nombre/contraseña como parte de sus escenarios, y si comparten cuenta con un uso real,
# cada corrida de tests pisa las credenciales reales sin aviso.
E2E_ODONTOLOGO_NOMBRE="Odontólogo de Prueba"
E2E_ODONTOLOGO_EMAIL="e2e-tests@example.com"
E2E_ODONTOLOGO_PASSWORD="PruebaE2E2026!"
